# ==============================================================================
# Django Configuration & Secrets (.env)
# ==============================================================================

# --- DJANGO CORE SETTINGS ---
# Set a strong 50+ character random secret key for production
SECRET_KEY=django-insecure-gw*@%^evwg=6cphxpypk(v1dgdoxupy!@iru=wh95qfiv)pfi5

# Set DEBUG=False in production! Set to True for local development
DEBUG=True

# Comma-separated allowed hosts (e.g., * for all hosts)
ALLOWED_HOSTS=*

# CORS: Set to True to allow cross-origin requests from any client origin (React, Next.js, mobile apps)
CORS_ALLOW_ALL_ORIGINS=True

# Comma-separated origins for CSRF protection in production (e.g., https://yourdomain.com)
CSRF_TRUSTED_ORIGINS=https://localhost:8000,http://127.0.0.1:8000,http://localhost:3000


# --- DATABASE CONFIGURATION ---
# Primary (Production): Neon DB PostgreSQL connection string
# Format: postgresql://[user]:[password]@[neon-hostname]/[database]?sslmode=require
# If left empty, the application automatically falls back to local SQLite (db.sqlite3).
DATABASE_URL=
# Example Neon URL:
# DATABASE_URL=postgresql://neondb_owner:npg_secret@ep-cool-snowflake-a5xyz-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require


# --- CACHE & CELERY BROKER CONFIGURATION ---
# Primary (Production): Upstash Serverless Redis URL (TLS enabled via rediss://)
# Format: rediss://default:[password]@[endpoint].upstash.io:[port]
# If left empty, the application automatically falls back to local Memurai on 127.0.0.1:6379.
UPSTASH_REDIS_URL=
# Example Upstash URL:
# UPSTASH_REDIS_URL=rediss://default:AbCdEfGh123456@us1-cool-stag-12345.upstash.io:6379

# Fallback Local Memurai URLs (used if UPSTASH_REDIS_URL is not set):
MEMURAI_CACHE_URL=redis://127.0.0.1:6379/5
MEMURAI_CELERY_URL=redis://127.0.0.1:6379/6


# --- AI SERVICES (GOOGLE GEMINI) ---
# Get your Gemini API key from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here


# --- EXTERNAL OTP SERVICE ---
OTP_SERVICE_IP=http://127.0.0.1:8000
OTP_REFERENCEID=5adntX0u8bD7DSgzq0aoJA


# --- PRODUCTION SECURITY (When DEBUG=False) ---
# Set to True in production to force HTTPS redirects
SECURE_SSL_REDIRECT=False